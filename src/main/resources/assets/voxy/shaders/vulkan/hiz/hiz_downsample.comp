#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, r32f) uniform readonly image2D inMip;
layout(binding = 1, r32f) uniform writeonly image2D outMip;

layout(push_constant) uniform PushConstants {
    ivec2 inSize;
    ivec2 outSize;
};

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= outSize.x || pos.y >= outSize.y) return;

    ivec2 inBase = pos * 2;
    float d0 = imageLoad(inMip, inBase).r;
    float d1 = imageLoad(inMip, min(inBase + ivec2(1, 0), inSize - 1)).r;
    float d2 = imageLoad(inMip, min(inBase + ivec2(0, 1), inSize - 1)).r;
    float d3 = imageLoad(inMip, min(inBase + ivec2(1, 1), inSize - 1)).r;

    float minDepth = min(min(d0, d1), min(d2, d3));
    imageStore(outMip, pos, vec4(minDepth, 0.0, 0.0, 0.0));
}
